# Copy this to .env on the server and fill in real values. Never commit .env itself.

# Postgres
POSTGRES_DB=jabartah_trivia
POSTGRES_USER=jabartah_trivia_user
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# ASP.NET Core's config-binding double-underscore convention (Section:Key -> Section__Key).
# Keep the password here identical to POSTGRES_PASSWORD above -- there's no
# compose-level interpolation tying them together, so update both by hand.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=jabartah_trivia;Username=jabartah_trivia_user;Password=replace-with-a-strong-random-password

Jwt__Issuer=Jabartah.Trivia
Jwt__Audience=Jabartah.Trivia.Client
Jwt__Key=replace-with-a-long-random-base64-signing-key-min-32-bytes
Jwt__ExpiryMinutes=10080

# Comma-separated list of exact-match production origins allowed by CORS,
# in addition to the existing localhost/LAN heuristic (which is untouched).
Cors__ExtraAllowedOrigins=https://<your-netlify-site>.netlify.app
